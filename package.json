{
  "name": "titleflix",
  "version": "2.0.0",
  "description": "Chrome extension that gives Netflix tabs and bookmarks the real name of what you're watching.",
  "author": "Dogu Yilmaz <hello@doguyilmaz.com>",
  "license": "MIT",
  "homepage": "https://github.com/doguyilmaz/titleflix",
  "repository": {
    "type": "git",
    "url": "https://github.com/doguyilmaz/titleflix.git"
  },
  "bugs": {
    "url": "https://github.com/doguyilmaz/titleflix/issues"
  },
  "keywords": [
    "chrome-extension",
    "netflix",
    "bookmarks",
    "tab-title",
    "productivity",
    "streaming"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/build.ts --watch",
    "package": "bun scripts/build.ts --zip",
    "icons": "bun scripts/render-icons.ts",
    "clean": "rm -rf dist *.zip",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun run build && playwright test",
    "check": "bun run lint && bun run test && bun run test:e2e",
    "bump": "bun scripts/bump-version.ts",
    "bump:patch": "bun scripts/bump-version.ts patch",
    "bump:minor": "bun scripts/bump-version.ts minor",
    "bump:major": "bun scripts/bump-version.ts major"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
